              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Chain the new id into {{projectId}} so the show/update/delete",
                  "// requests below work without manual editing.",
                  "try {",
                  "    const body = pm.response.json();",
                  "    const id = (body.data && body.data.id) || body.id;",
                  "    if (id) {",
                  "        pm.environment.set('projectId', id);",
                  "    }",
                  "} catch (e) {",
                  "    console.error('Response was not JSON.');",
                  "}"
                ]
