  ],
  "item": [
    {
      "name": "USER",
      "item": [
        {
          "name": "LOGIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Captures the Sanctum token into the environment so every other",
                  "// request in this collection can inherit Bearer auth.",
                  "let body = {};",
                  "",
                  "try {",
                  "    body = pm.response.json();",
                  "} catch (e) {",
                  "    console.error('Response was not JSON. Is Accept: application/json set?');",
                  "}",
                  "",
                  "pm.test('login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200 && body.token) {",
                  "    pm.environment.set('token', body.token);",
                  "    if (body.user && body.user.id) {",
                  "        pm.environment.set('userId', body.user.id);",
                  "    }",
                  "    console.log('token stored in environment');",
                  "} else {",
                  "    pm.environment.unset('token');",
                  "    console.warn('No token in response. Add $user->createToken(\\'api\\')->plainTextToken to UserController::login.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{testUsername}}\",\n    \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "login"
              ]
            },
            "description": "Run REGISTER first on a fresh database, then this. Credentials come from {{testUsername}} / {{testPassword}} so both requests always agree.\n\nThe post-response script writes `token` into the active environment. A 401 with \"Username or password invalid\" means the user does not exist yet."
          },
          "response": []
        },
        {
          "name": "REGISTER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 422) {",
                  "    console.warn('422 usually means {{testEmail}} is already registered. The email column is unique, so just run LOGIN instead.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{testUsername}}\",\n    \"email\": \"{{testEmail}}\",\n    \"type\": 2,\n    \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "register"
              ]
            },
            "description": "UserController::register validates username, email, type, password. `phone` is not in the validated set or the users table, so it was dropped from this body."
          },
          "response": []
        },
        {
          "name": "ME (requires token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
