{
  "info": {
    "_postman_id": "9fd90abd-c8f6-420a-bca7-d2773b0880bb",
    "name": "REPOSITORY_USTP",
    "description": "API collection for REPOSITORY-USTP-API.\n\nSetup\n1. Select the `REPOSITORY_USTP Local` environment (REPOSITORY_USTP.postman_environment.json).\n2. Start the stack: `docker compose up -d db` then `php artisan serve`.\n3. Run `USER / LOGIN` once. Its post-response script stores `token` in the environment, and every other request inherits Bearer auth from this collection.\n\nConventions\n- Host is always `{{baseUrl}}`, never a hardcoded 127.0.0.1.\n- Every request sends `Accept: application/json` so Laravel returns JSON errors instead of a full HTML debug page.\n- Requests marked NOT IMPLEMENTED have no matching route in routes/api.php yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "36723805",
    "_collection_link": "https://go.postman.co/collection/36723805-9fd90abd-c8f6-420a-bca7-d2773b0880bb?source=collection_link"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.name) {",
          "    console.warn('No environment selected. {{baseUrl}} and {{token}} will not resolve.');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "Fallback only. The selected environment should override this."
    },
